// AI Marking Service — data model.
//
// The service never receives student names or IDs: a client sends an opaque `externalId` per
// answer plus the answer text, and maps results back on its side.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EvaluationStatus {
  queued
  running
  completed
  failed
}

enum Lane {
  realtime
  deferred
}

enum ReviewDecision {
  accepted
  adjusted
  rejected
}

enum LlmCallKind {
  marking
  rubric_draft
  feedback_rewrite
}

enum WebhookStatus {
  pending
  delivered
  failed
}

// A project that uses this service (e.g. the e-Exam system). Each has its own API key.
model Client {
  id               String   @id @default(uuid())
  name             String   @unique
  apiKeyHash       String   @unique
  apiKeyPrefix     String
  webhookUrl       String?
  webhookSecret    String
  monthlyBudgetUsd Decimal? @db.Decimal(12, 4)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions   QuestionContext[]
  evaluations Evaluation[]
  llmCalls    LlmCall[]
  webhooks    WebhookDelivery[]
}

// The shared part of every marking request: question, model answer and approved rubric.
// Deduplicated per client by a hash of its content, so answers to the same question share it.
model QuestionContext {
  id          String   @id @default(uuid())
  clientId    String
  externalId  String?
  contentHash String
  text        String
  modelAnswer String
  maxMarks    Float
  markStep    Float    @default(0.5)
  rubric      Json
  rubricHash  String
  createdAt   DateTime @default(now())

  client      Client       @relation(fields: [clientId], references: [id])
  evaluations Evaluation[]

  @@unique([clientId, contentHash])
  @@index([clientId, externalId])
}

model Evaluation {
  id           String           @id @default(uuid())
  clientId     String
  questionId   String
  groupId      String?
  externalId   String
  answerText   String
  answerHash   String
  lane         Lane
  status       EvaluationStatus @default(queued)
  runCount     Int              @default(0)
  callbackUrl  String?
  reusedFromId String?

  suggestedScore  Float?
  maxMarks        Float
  criteria        Json?
  summary         String?
  strengths       String[]
  weaknesses      String[]
  highlights      Json?
  missing         Json?
  studentFeedback Json?
  confidence      Float?
  flags           String[]
  model           String?
  host            String?
  promptVersion   String?
  error           String?

  decision      ReviewDecision?
  finalScore    Float?
  finalCriteria Json?
  finalFeedback Json?
  reviewedAt    DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  client   Client          @relation(fields: [clientId], references: [id])
  question QuestionContext @relation(fields: [questionId], references: [id])

  @@unique([clientId, questionId, externalId])
  @@index([clientId, groupId, status])
  @@index([questionId, answerHash])
  @@index([clientId, updatedAt])
}

// One row per LLM request, successful or not: the usage and cost ledger.
model LlmCall {
  id              BigInt      @id @default(autoincrement())
  clientId        String
  evaluationId    String?
  kind            LlmCallKind
  model           String
  host            String?
  promptVersion   String
  inputTokens     Int         @default(0)
  outputTokens    Int         @default(0)
  cachedTokens    Int         @default(0)
  reasoningTokens Int         @default(0)
  costUsd         Decimal     @default(0) @db.Decimal(12, 6)
  latencyMs       Int
  ok              Boolean
  error           String?
  createdAt       DateTime    @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, createdAt])
  @@index([evaluationId])
}

model WebhookDelivery {
  id             String        @id @default(uuid())
  clientId       String
  evaluationId   String
  event          String
  url            String
  status         WebhookStatus @default(pending)
  attempts       Int           @default(0)
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime      @default(now())
  deliveredAt    DateTime?

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId, status])
  @@index([evaluationId])
}
