# Copy to .env for local development.
NODE_ENV=development
PORT=4200
LOG_LEVEL=info

DATABASE_URL=postgresql://ams:ams_dev_password@localhost:5440/ams_dev?schema=public
REDIS_URL=redis://localhost:6390
# true = the API process also runs the queue workers (handy locally). Production runs a separate worker.
RUN_EMBEDDED_WORKERS=true

# mock = deterministic fake marking, no API key and no cost. openrouter = real model.
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Pinned hosts, tried in order with fallback between them only.
OPENROUTER_PROVIDERS=deepinfra,parasail
OPENROUTER_QUANTIZATIONS=fp8
OPENROUTER_ZDR=true
# off | low | medium | high. This model reasons by default; off is cheaper and faster.
OPENROUTER_REASONING=off

# Queue throughput (jobs per RATE_DURATION_MS, shared by all worker replicas).
REALTIME_CONCURRENCY=20
REALTIME_RATE_MAX=30
DEFERRED_CONCURRENCY=10
DEFERRED_RATE_MAX=5

# Lane router.
ROUTER_FIRST_N_REALTIME=20
ROUTER_SMALL_GROUP_MAX=300

# The LLM_*/OPENROUTER_*/PRICE_* values above only seed the first model profile; after that,
# manage models in the console. Prices are USD per 1M tokens (used when a provider reports no cost).
PRICE_INPUT_PER_MTOK=0.06
PRICE_CACHED_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0.18

# Encrypts stored project API keys so the console can show them again. 32+ random characters,
# e.g. `openssl rand -base64 36`. Without it keys are shown once only. Changing it makes stored keys
# unreadable until they are rotated.
SECRETS_ENCRYPTION_KEY=

# Operator console (served at /console; dev server: pnpm console:dev on :5180).
PUBLIC_URL=http://localhost:4200
ADMIN_SESSION_HOURS=12
