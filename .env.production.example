# Copy to .env.production on the AI server. Never commit the filled-in copy.
POSTGRES_PASSWORD=change-me-long-random
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: shown to OpenRouter as the calling app.
OPENROUTER_APP_URL=https://ai.example.edu
# deepinfra,parasail are fp8 hosts with zero data retention and strict JSON support.
OPENROUTER_PROVIDERS=deepinfra,parasail
OPENROUTER_REASONING=off
LOG_LEVEL=info

# Public HTTPS address of this service (shown in the console's client integration details).
PUBLIC_URL=https://ai.example.edu

# The OpenRouter settings above only seed the first model profile. After the first start, manage
# models, hosts and prices in the console (/console → Models & providers).
# A profile for another OpenAI-compatible provider names its key variable here, e.g.:
# DEEPSEEK_API_KEY=sk-...

# Operator console sessions (hours). Cookies are Secure in production.
ADMIN_SESSION_HOURS=12
